# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_NAME=ata-auth-service
FRONTEND_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://ata_user:ata_password@localhost:5432/ata_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT (RS256) ──────────────────────────────────────────────────────────────
# Generate keys:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   export JWT_PRIVATE_KEY=$(base64 -i private.pem)
#   export JWT_PUBLIC_KEY=$(base64 -i public.pem)
JWT_PRIVATE_KEY=<base64-encoded-RSA-private-key-PEM>
JWT_PUBLIC_KEY=<base64-encoded-RSA-public-key-PEM>
JWT_ACCESS_TOKEN_TTL=900        # seconds (15 min)
JWT_REFRESH_TOKEN_TTL=604800    # seconds (7 days)

# ─── Email (MailHog for dev; replace with SES/SendGrid in prod) ───────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
EMAIL_FROM=noreply@ata.local

# ─── OAuth – Google ───────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/oauth/google/callback

# ─── OAuth – GitHub ───────────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/auth/oauth/github/callback

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REGISTER_WINDOW_MS=3600000

# ─── Internal API ─────────────────────────────────────────────────────────────
# Shared secret used by the gateway and other services to call internal endpoints
INTERNAL_API_KEY=change-me-to-a-strong-random-secret-in-production
