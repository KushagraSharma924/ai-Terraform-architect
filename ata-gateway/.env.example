# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# ─── JWT (same RS256 public key as auth-service) ──────────────────────────────
JWT_PUBLIC_KEY=<base64-encoded-RSA-public-key-PEM>

# ─── Upstream services ────────────────────────────────────────────────────────
AUTH_SERVICE_URL=http://localhost:3001
PROJECT_SERVICE_URL=http://localhost:3002

# ─── Internal API key ─────────────────────────────────────────────────────────
INTERNAL_API_KEY=change-me-in-production

# ─── Redis (rate limiting) ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
